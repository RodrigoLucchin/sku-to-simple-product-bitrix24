    {
      "parameters": {
        "jsCode": "let output = [];\n\nfor (const item of items) {\n  const result = item.json.result || {};\n  const product = result.product || {};\n  const prices = result.prices || [];\n  const images = result.productImages || [];\n\n  const priceList = prices.length ? prices : [{}];\n\n  for (const price of priceList) {\n    output.push({\n      json: {\n        total: item.json.total || null,\n        time: item.json.time || null,\n\n        productId: product.id || product.ID || null,\n        productName: product.name || product.NAME || null,\n        type: product.type || product.TYPE || null,\n        iblockId: product.iblockId || null,\n        parentId: product.parentId?.value || null,\n        price: price.price || null,\n        currency: price.currency || null,\n        imageUrl: images[0]?.detailUrl || null,\n        active: product.active === \"Y\",\n        available: product.available === \"Y\",\n        quantity: product.quantity || 0,\n        xmlId: product.xmlId || product.XML_ID || null,\n      }\n    });\n  }\n}\n\nreturn output;\n"
      },
